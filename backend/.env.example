# Configuración del Backend NestJS
PORT=3001
NODE_ENV=development

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/gestion_firmas?schema=public

# Redis (Caché de Presencia y Colas BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PRESENCE_TTL=3600

# Object Storage S3 / MinIO
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=evidencias-firmas

# Seguridad y Ciberseguridad (Ley N° 21.663)
JWT_SECRET=supersecret-jwt-token-coquimbo-2026
TELEMETRIA_API_KEY=muni-coquimbo-ghost-app-sec-key-2026
HMAC_SECRET=ciberseguridad-municipio-key
