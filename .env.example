# ==============================================================================
# VARIABLES DE ENTORNO: GESTIÓN DE FIRMAS Y TELEMETRÍA (MUNICIPALIDAD DE COQUIMBO)
# ==============================================================================

# Configuración General del Entorno
NODE_ENV=development
APP_PORT=80

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=gestion_firmas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/gestion_firmas?schema=public

# Redis 7 (Telemetría con TTL y Colas BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PRESENCE_TTL=3600

# MinIO S3 (Object Storage de Evidencias y Documentos Firmados)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=evidencias-firmas

# Seguridad y Ciberseguridad (Cumplimiento Ley N° 21.663 - ANCI)
JWT_SECRET=coquimbo_secret_key_ciberseguridad_2026
TELEMETRIA_API_KEY=muni-coquimbo-ghost-app-sec-key-2026
HMAC_SECRET=ciberseguridad-municipio-key-2026
