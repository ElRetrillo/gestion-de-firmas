# Plantilla de entorno para despliegue en VM (Docker Compose)
NODE_ENV=production
CORS_ORIGINS=https://tu-dominio.cl
PUBLIC_APP_URL=https://tu-dominio.cl

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=gestion_firmas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/gestion_firmas?schema=public

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PRESENCE_TTL=3600

# Seguridad (generar con: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_JWT_SECRET_HEX_32
TELEMETRIA_API_KEY=CHANGE_ME_TELEMETRIA_API_KEY_HEX_24
TOTP_ISSUER=Gestion de tokens - I.Municipalidad de Coquimbo

# Identidad institucional por defecto
DEFAULT_ORG_NAME=Ilustre Municipalidad de Coquimbo
DEFAULT_DEPENDENCIA_FISICA=Red Interna Municipal - Coquimbo

# Administrador inicial (se crea si no existe ningún ADMIN en BD)
ADMIN_INICIAL_RUT=11.111.111-1
ADMIN_INICIAL_NOMBRE=Administrador Principal
ADMIN_INICIAL_EMAIL=admin@institucion.cl
ADMIN_INICIAL_CARGO=Administrador General de Sistemas
ADMIN_INICIAL_UNIDAD=Departamento de Gestión de Sistemas y TICS
ADMIN_INICIAL_PASSWORD=CHANGE_ME_ADMIN_PIN_OR_PASS
ADMIN_INICIAL_PIN=CHANGE_ME_ADMIN_PIN

# Superadmins adicionales opcionales en JSON array: [{"rut":"...","nombre":"...","email":"...","cargo":"...","unidad":"...","pinInicial":"123456"}]
EXTRA_SUPERADMINS_JSON=
SUPERADMINS_FIJOS_JSON=

# Correo saliente SMTP (avisos de caducidad)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER@dominio.cl
SMTP_PASS=CHANGE_ME_SMTP_APP_PASSWORD
SMTP_FROM="Oficina de Transformación Digital - Departamento de Gestión de Sistemas y TICS <CHANGE_ME_SMTP_USER@dominio.cl>"

# Datos de contacto de la plantilla de correo
MAIL_OFFICE_NAME=Oficina de Transformación Digital
MAIL_DEPT_NAME=Departamento de Gestión de Sistemas y TICS
MAIL_CONTACT_PHONE=+569 91682880
MAIL_CONTACT_EMAIL=transformaciondigital@municoquimbo.cl
MAIL_WEB_URL=municoquimbo.cl
