NODE_ENV=production
APP_PORT=80
APP_SSL_PORT=443
CORS_ORIGINS=*

# Control de Base de Datos (false = Base en 0 sin datos de prueba falsos)
SEED_DEMO_DATA=false

# Administrador Inicial Institucional (Inyección automática en base limpia)
ADMIN_INICIAL_RUT=21.374.808-4
ADMIN_INICIAL_NOMBRE=Daniel Alejandro Trigo Tabilo
ADMIN_INICIAL_EMAIL=daniel.trigo@alumnos.ucn.cl
ADMIN_INICIAL_CARGO=Administrador General de Sistemas
ADMIN_INICIAL_UNIDAD=Dirección de TICs
ADMIN_INICIAL_PASSWORD=1908
ADMIN_INICIAL_PIN=1908

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_CLAVE_ALEATORIA_HEX
POSTGRES_DB=gestion_firmas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:CAMBIAR_POR_CLAVE_ALEATORIA_HEX@postgres:5432/gestion_firmas?schema=public

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PRESENCE_TTL=3600

# MinIO S3 (Almacenamiento seguro de evidencias y actas)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CAMBIAR_POR_CLAVE_MINIO_HEX
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=evidencias-firmas

# Seguridad Criptográfica y Telemetría (Generar con: openssl rand -hex 32)
JWT_SECRET=GENERAR_CON_OPENSSL_HEX_32
TELEMETRIA_API_KEY=GENERAR_CON_OPENSSL_HEX_24
HMAC_SECRET=GENERAR_CON_OPENSSL_HEX_32

# Integraciones de Firma Externa
FIRMAGOB_API_URL=https://api.firmagob.digital.gob.cl/v1
FIRMAGOB_API_TOKEN=
ESIGN_API_URL=https://api.esign.cl/v2
ESIGN_API_KEY=
CLAVEUNICA_CLIENT_ID=
CLAVEUNICA_CLIENT_SECRET=
AD_LDAP_URL=
